import java.util.*;

class Solution {
    public List<String> findAndReplacePattern(String[] words, String pattern) {
        List<String> result = new ArrayList<>();

        for (String word : words) {
            int[] p = new int[26];
            int[] w = new int[26];
            Arrays.fill(p, -1);
            Arrays.fill(w, -1);

            boolean match = true;

            for (int i = 0; i < pattern.length(); i++) {
                int a = pattern.charAt(i) - 'a';
                int b = word.charAt(i) - 'a';

                if (p[a] == -1 && w[b] == -1) {
                    p[a] = b;
                    w[b] = a;
                } else if (p[a] != b || w[b] != a) {
                    match = false;
                    break;
                }
            }

            if (match) {
                result.add(word);
            }
        }

        return result;
    }
}
