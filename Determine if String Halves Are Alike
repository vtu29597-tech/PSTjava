class Solution {
    public boolean halvesAreAlike(String s) {
        boolean[] isVowel = new boolean[128];
        for (char c : "aeiouAEIOU".toCharArray()) {
            isVowel[c] = true;
        }
        
        int count = 0;
        int mid = s.length() / 2;
        
        for (int i = 0; i < mid; i++) {
            if (isVowel[s.charAt(i)]) count++;
            if (isVowel[s.charAt(i + mid)]) count--;
        }
        
        return count == 0;
    }
}
