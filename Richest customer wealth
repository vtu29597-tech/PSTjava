public class Solution {
    public int maximumWealth(int[][] accounts) {
        int maxWealth = 0;

        // Iterate through each customer (row)
        for (int[] customer : accounts) {
            int currentWealth = 0;
            
            // Sum all bank accounts for the current customer
            for (int bank : customer) {
                currentWealth += bank;
            }
            
            // Update max wealth if current customer is richer
            maxWealth = Math.max(maxWealth, currentWealth);
        }

        return maxWealth;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();

        // Example 1
        int[][] accounts1 = {{1, 2, 3}, {3, 2, 1}};
        System.out.println(sol.maximumWealth(accounts1)); // Output: 6

        // Example 2
        int[][] accounts2 = {{1, 5}, {7, 3}, {3, 5}};
        System.out.println(sol.maximumWealth(accounts2)); // Output: 10

        // Example 3
        int[][] accounts3 = {{2, 8, 7}, {7, 1, 3}, {1, 9, 5}};
        System.out.println(sol.maximumWealth(accounts3)); // Output: 17
    }
}
