public class Solution {
    public int[] buildArray(int[] nums) {
        int n = nums.length;
        int[] ans = new int[n];

        for (int i = 0; i < n; i++) {
            ans[i] = nums[nums[i]];
        }

        return ans;
    }

    public static void main(String[] args) {
        Solution sol = new Solution();

        // Example 1
        int[] result1 = sol.buildArray(new int[]{0, 2, 1, 5, 3, 4});
        System.out.println(java.util.Arrays.toString(result1)); // [0, 1, 2, 4, 5, 3]

        // Example 2
        int[] result2 = sol.buildArray(new int[]{5, 0, 1, 2, 3, 4});
        System.out.println(java.util.Arrays.toString(result2)); // [4, 5, 0, 1, 2, 3]
    }
}
